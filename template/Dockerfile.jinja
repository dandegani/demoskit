FROM python:{{ python_version }}-slim

# git + curl, Node 20 and the Claude Code CLI (ClaudeAgent runs it as a subprocess).
RUN apt-get update \
 && apt-get install -y --no-install-recommends git curl ca-certificates \
 && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
 && apt-get install -y --no-install-recommends nodejs \
 && npm install -g @anthropic-ai/claude-code@2.1.197 \
 && rm -rf /var/lib/apt/lists/*

# Non-root user with a writable home: the Claude CLI keeps its state under $HOME.
RUN useradd --create-home --home-dir /home/app --shell /bin/bash app
ENV HOME=/home/app PYTHONUNBUFFERED=1 AGENTOS_HOST=0.0.0.0 AGENTOS_PORT={{ port }}

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY . .
RUN mkdir -p /app/data && chown -R app:app /app
USER app

EXPOSE {{ port }}
CMD ["python", "main.py"]
