{% raw %}# The same gate as `make check`, on every pull request and on main. A skipped test fails it.
name: check
on:
  pull_request:
  push:
    branches: [main]
concurrency:
  group: check-${{ github.ref }}
  cancel-in-progress: true
jobs:
  check:
    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "{% endraw %}{{ python_version }}{% raw %}"
          cache: pip
          cache-dependency-path: requirements.txt
      - run: pip install -r requirements.txt
      - run: npm install -g @fission-ai/openspec@1.14.3
      - run: make check
{% endraw %}