# Copy to .env (never committed). Literal KEY=value lines, no shell.
AGENTOS_PORT={{ port }}
# Bearer token for the API (every route except /health). Generate: openssl rand -hex 32
OS_SECURITY_KEY=
# Claude for the agents: a subscription token from `claude setup-token` ...
CLAUDE_CODE_OAUTH_TOKEN=
# ... or pay-per-use API billing instead (console.anthropic.com).
# ANTHROPIC_API_KEY=
AGENTOS_DB=data/agentos.db
{%- if needs_postgres %}
POSTGRES_USER={{ product_name | replace('-', '_') }}
POSTGRES_PASSWORD=
POSTGRES_DB={{ product_name | replace('-', '_') }}
{%- endif %}
