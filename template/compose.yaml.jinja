services:
  agentos:
    build: .
    env_file: .env
    environment:
      AGENTOS_HOST: 0.0.0.0
      AGENTOS_PORT: "{{ port }}"
    volumes:
      - ./data:/app/data
    ports:
      - "127.0.0.1:{{ port }}:{{ port }}"
    restart: unless-stopped
{%- if needs_postgres %}
    depends_on:
      postgres:
        condition: service_healthy
{%- endif %}
    healthcheck:
      test: ["CMD", "curl", "-fsS", "http://127.0.0.1:{{ port }}/health"]
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 30s
    logging:
      driver: json-file
      options: { max-size: "10m", max-file: "5" }
    mem_limit: 1g
{%- if needs_postgres %}

  postgres:
    image: pgvector/pgvector:pg16
    env_file: .env
    volumes:
      - pgdata:/var/lib/postgresql/data
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U $${POSTGRES_USER} -d $${POSTGRES_DB}"]
      interval: 5s
      timeout: 5s
      retries: 10
    logging:
      driver: json-file
      options: { max-size: "10m", max-file: "5" }

volumes:
  pgdata:
{%- endif %}
