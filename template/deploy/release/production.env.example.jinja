# {{ product_title }} production behind the edge. Read by deploy.sh.
# Copy to production.env (committed: it holds no secrets) and fill in the host.
# DEPLOY_KEY: the ssh key (GitHub: the production environment secret; by hand: the default).
SSH="ssh -i ${DEPLOY_KEY:-/home/ubuntu/.ssh/PROD_KEY.pem} ${DEPLOY_SSH_OPTS:-} -o IdentitiesOnly=yes -o BatchMode=yes -o ConnectTimeout=15 ubuntu@PROD_HOST"
DIR=/home/ubuntu/{{ product_name }}
COMPOSE="docker compose -f compose.yaml -f compose.prod.yaml"
BUILD_SERVICES="agentos"
APP_SERVICE=agentos
APP_CONTAINER={{ product_name }}-agentos-1
{%- if needs_postgres %}
PG_CONTAINER={{ product_name }}-postgres-1
{%- else %}
# No database container: no alembic compare, no DB restore on rollback.
PG_CONTAINER=
{%- endif %}
IMAGES="{{ product_name }}-agentos"
HEALTH_URL=https://{{ domain }}/health
SMOKE_URLS=""
# Runs on the host before the code changes; must print "wrote <path>" for the dump it made.
# BACKUP_CMD="bash /home/ubuntu/backup/backup-to-s3.sh /home/ubuntu/backup/{{ product_name }}.env"
HEALTH_TIMEOUT=180
